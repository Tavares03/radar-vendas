# =====================================================================================
# Radar de Vendas — configuração
#
# Copie este arquivo para `.env` e ajuste. Tudo aqui é opcional para testar localmente:
# `docker compose up --build` funciona sem `.env`, com valores de desenvolvimento.
#
# NUNCA versione o `.env`. Ele já está no .gitignore.
# =====================================================================================

# ------------------------------------------------------------------ essencial em produção
# Segredo que assina as sessões e deriva as chaves de cifragem. 32+ caracteres.
# Gere com: python -c "import secrets; print(secrets.token_urlsafe(48))"
# ATENÇÃO: trocar este valor invalida as sessões e torna ilegível o texto bruto já cifrado.
RADAR_SECRET_KEY=

# PostgreSQL: o único banco (dados e fila de jobs). Só vale na primeira subida, quando o volume
# do banco ainda está vazio; para trocar depois, use ALTER USER no próprio banco.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# dev | prod. Em prod a aplicação se recusa a subir com o segredo de desenvolvimento.
RADAR_ENVIRONMENT=dev

# URL pública do painel (usada nos links dos alertas).
RADAR_PUBLIC_BASE_URL=http://localhost:3000
# true quando o painel é servido por HTTPS.
RADAR_COOKIE_SECURE=false

# ------------------------------------------------------------------ primeiro acesso
# true carrega a empresa de demonstração na primeira subida, se ainda não houver nenhum usuário
# (nunca com RADAR_ENVIRONMENT=prod). Logins: admin@demo.radar, gestor@demo.radar e
# vendedor@demo.radar. Sem RADAR_DEMO_PASSWORD, a senha é sorteada e aparece uma vez no log da
# API (docker compose logs api | grep demonstracao_criada). Ela aceita qualquer tamanho (ex.:
# 123456), só para a demonstração; só vale na primeira carga, com o banco ainda vazio.
RADAR_SEED_DEMO=true
RADAR_DEMO_PASSWORD=
# Para criar a sua empresa e o seu administrador na primeira subida:
RADAR_BOOTSTRAP_TENANT_NAME=
RADAR_BOOTSTRAP_ADMIN_EMAIL=
RADAR_BOOTSTRAP_ADMIN_PASSWORD=
# true permite que qualquer pessoa crie uma empresa pela API (POST /api/v1/auth/signup).
RADAR_ALLOW_SIGNUP=false

# ------------------------------------------------------------------ LLM (tudo gratuito)
# cloud: usa a cadeia abaixo, na ordem, com failover.
# local: só Ollama — nenhum dado sai da máquina.
# off:   sem LLM — a análise roda com regras + classificador próprio.
RADAR_LLM_MODE=cloud
RADAR_LLM_PROVIDERS=groq,gemini,openrouter,ollama

# Groq — https://console.groq.com/keys
GROQ_API_KEY=
RADAR_GROQ_MODEL=openai/gpt-oss-120b
# Raciocínio dos modelos gpt-oss: low | medium | high. Com medium o raciocínio gasta quase todo o
# teto de resposta e o JSON da análise sai cortado; low dá respostas completas e mais rápidas.
RADAR_GROQ_REASONING_EFFORT=low

# Google Gemini — https://aistudio.google.com/apikey
GEMINI_API_KEY=
RADAR_GEMINI_MODEL=gemini-flash-lite-latest

# OpenRouter (modelos ":free") — https://openrouter.ai/keys
OPENROUTER_API_KEY=
RADAR_OPENROUTER_MODEL=google/gemma-4-31b-it:free

# Ollama (local). Com `docker compose --profile local up`, use http://ollama:11434
RADAR_OLLAMA_BASE_URL=
RADAR_OLLAMA_MODEL=qwen3:4b

# ------------------------------------------------------------------ transcrição de áudio
RADAR_TRANSCRIPTION_ENABLED=true
# tiny | base | small | medium | large-v3 (maior = melhor e mais lento)
RADAR_WHISPER_MODEL=small

# ------------------------------------------------------------------ LGPD: retenção padrão
# Prazos (em dias) que cada empresa nova recebe; cada empresa ajusta os seus nas configurações.
# Texto original das mensagens e áudios são apagados depois desse prazo (0 = nunca).
# Detalhes em docs/LGPD.md.
RADAR_DEFAULT_RETENTION_RAW_DAYS=90
RADAR_DEFAULT_RETENTION_MEDIA_DAYS=30

# ------------------------------------------------------------------ modelos próprios
# auto: usa a pasta ./models se existir; senão o id do Hugging Face abaixo; senão desliga.
# off:  desliga a camada (o sistema continua funcionando sem ela).
RADAR_NER_MODEL=auto
RADAR_CLASSIFIER_MODEL=auto
RADAR_EMBEDDING_MODEL=auto
RADAR_NER_HUB_ID=
RADAR_CLASSIFIER_HUB_ID=
# Threads do ONNX Runtime por modelo (0 = padrão). `radar models` mostra o que está em uso.
RADAR_ML_THREADS=0
# Só é necessário para publicar modelos/dataset (scripts/publish_hf.py). Ver docs/TREINAMENTO.md.
HF_TOKEN=

# ------------------------------------------------------------------ alertas
RADAR_SMTP_HOST=
RADAR_SMTP_PORT=587
RADAR_SMTP_USER=
RADAR_SMTP_PASSWORD=
RADAR_SMTP_FROM=Radar de Vendas <radar@localhost>
RADAR_SMTP_STARTTLS=true
# Bot criado com o @BotFather.
RADAR_TELEGRAM_BOT_TOKEN=
# true permite webhooks de saída para endereços internos (ex.: o N8N do próprio Compose).
RADAR_WEBHOOK_ALLOW_PRIVATE_HOSTS=false

# ------------------------------------------------------------------ WhatsApp ao vivo
# Sobe com: docker compose --profile whatsapp up -d   (Evolution API, no mesmo PostgreSQL)
# Recomendado: WhatsApp Business com número só de trabalho (tudo o que chega no número entra).
# Chave entre o Radar e a Evolution. Gere com: python -c "import secrets; print(secrets.token_urlsafe(32))"
EVOLUTION_API_KEY=
# Minutos sem mensagem nova até a conversa ao vivo ser analisada pelo LLM.
RADAR_WHATSAPP_IDLE_MINUTES=30

# ------------------------------------------------------------------ operação
RADAR_LOG_LEVEL=INFO
# Se definido, GET /api/metrics exige "Authorization: Bearer <token>".
RADAR_METRICS_TOKEN=

# Portas publicadas na máquina
RADAR_WEB_PORT=3000
RADAR_API_PORT=8000
RADAR_DB_PORT=5433
# Painel da Evolution API (diagnóstico), só com o perfil whatsapp: http://localhost:8081/manager
RADAR_EVOLUTION_PORT=8081
